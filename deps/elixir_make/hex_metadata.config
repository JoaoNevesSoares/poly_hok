  <<"lib/elixir_make/artefact.ex">>,
  <<"lib/elixir_make/compiler.ex">>,
  <<"lib/elixir_make/downloader">>,
  <<"lib/elixir_make/downloader.ex">>,
  <<"lib/elixir_make/downloader/httpc.ex">>,
  <<"lib/elixir_make/precompiler.ex">>,
  <<"lib/mix">>,
  <<"lib/mix/tasks">>,
  <<"lib/mix/tasks/compile.elixir_make.ex">>,
  <<"lib/mix/tasks/elixir_make.checksum.ex">>,
  <<"lib/mix/tasks/elixir_make.precompile.ex">>,
  <<"mix.exs">>]}.
